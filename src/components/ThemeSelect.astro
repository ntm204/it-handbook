---
// Chọn giao diện: 3 nút biểu tượng (Theo máy · Sáng · Tối) thay cho ô <select> mặc định.
// Dùng cùng khoá localStorage với Starlight ("starlight-theme") nên lựa chọn cũ vẫn giữ.
import { Icon } from "@astrojs/starlight/components";

const options = [
  { value: "auto", icon: "laptop", label: "Theo máy" },
  { value: "light", icon: "sun", label: "Sáng" },
  { value: "dark", icon: "moon", label: "Tối" },
] as const;
---

<hb-theme-switch>
  <div class="hb-theme" role="radiogroup" aria-label="Giao diện">
    {options.map((o) => (
      <button type="button" role="radio" aria-checked="false" tabindex="-1"
              data-value={o.value} aria-label={o.label} data-tip={o.label}>
        <Icon name={o.icon} size="1rem" />
      </button>
    ))}
  </div>
</hb-theme-switch>

<script>
  type Theme = "auto" | "light" | "dark";
  const KEY = "starlight-theme";
  const parse = (v: unknown): Theme => (v === "light" || v === "dark" ? v : "auto");
  const load = (): Theme => { try { return parse(localStorage.getItem(KEY)); } catch { return "auto"; } };
  const system = () => (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");

  function apply(theme: Theme) {
    document.documentElement.dataset.theme = theme === "auto" ? system() : theme;
    try { localStorage.setItem(KEY, theme === "auto" ? "" : theme); } catch {}
    document.querySelectorAll("hb-theme-switch button").forEach((b) => {
      const on = (b as HTMLElement).dataset.value === theme;
      b.setAttribute("aria-checked", String(on));
      b.setAttribute("tabindex", on ? "0" : "-1");
    });
  }

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => { if (load() === "auto") apply("auto"); });

  class HbThemeSwitch extends HTMLElement {
    connectedCallback() {
      apply(load());
      const buttons = Array.from(this.querySelectorAll("button")) as HTMLElement[];
      buttons.forEach((b, i) => {
        b.addEventListener("click", () => apply(parse(b.dataset.value)));
        // Phím mũi tên chuyển lựa chọn, đúng hành vi của nhóm radio
        b.addEventListener("keydown", (e) => {
          const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          const next = buttons[(i + step + buttons.length) % buttons.length];
          apply(parse(next.dataset.value));
          next.focus();
        });
      });
    }
  }
  if (!customElements.get("hb-theme-switch")) customElements.define("hb-theme-switch", HbThemeSwitch);
</script>

<style>
  .hb-theme {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--hb-surface);
    border: 1px solid var(--hb-border);
  }
  button {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  button:hover { color: var(--sl-color-white); }
  button[aria-checked="true"] {
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25), 0 0 0 1px var(--hb-border);
  }
  @media (max-width: 50rem) {
    button { width: 2.6rem; height: 2.6rem; }   /* vùng chạm đủ lớn trên điện thoại */
  }
</style>
